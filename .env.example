# Copie para .env e ajuste.
# Local (SQLite, padrão):
DATABASE_URL=sqlite:///./data/portaria.db
# Servidor (PostgreSQL):
# DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/portaria

# Troque por um valor longo e aleatório (ex.: python -c "import secrets;print(secrets.token_hex(32))")
SECRET_KEY=troque-esta-chave
# Usuário administrador criado no primeiro início, se não houver usuários
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha
# true quando estiver servindo por HTTPS
COOKIE_SECURE=false
TIMEZONE=America/Sao_Paulo
